############################################################
# POST - SKAPA KUND LOKALT
############################################################

### Skapa ny kund lokalt
POST {{CreditScoreHost}}/api/customers
Content-Type: application/json

{
  "socialSecurityNumber": "19000101-9999",
  "name": "Test Person",
  "annualIncome": 450000,
  "totalDebt": 100000
}



############################################################
# PUT - UPPDATERA KUND LOKALT
############################################################

### Uppdatera Test Person
PUT {{CreditScoreHost}}/api/customers/19000101-9999
Content-Type: application/json

{
  "annualIncome": 10000000,
  "totalDebt": 10000
}


### Kontrollera uppdaterat Credit Score
GET {{CreditScoreHost}}/api/customers/19000101-9999/credit-score


### Uppdatera kund som inte finns - förväntat 404
PUT {{CreditScoreHost}}/api/customers/19000101-8888
Content-Type: application/json

{
  "annualIncome": 600000,
  "totalDebt": 120000
}



############################################################
# PRODUCTION / INMEMORY - LOKALT
#
# Dessa används när ASPNETCORE_ENVIRONMENT = Production.
############################################################

### Production - skapa ny kund
POST {{CreditScoreHost}}/api/customers
Content-Type: application/json

{
  "socialSecurityNumber": "19991111-4325",
  "name": "Production Test",
  "annualIncome": 500000,
  "totalDebt": 125000
}


### Production - uppdatera kund
PUT {{CreditScoreHost}}/api/customers/19991111-4325
Content-Type: application/json

{
  "annualIncome": 600000,
  "totalDebt": 120000
}


### Production - verifiera uppdateringen
GET {{CreditScoreHost}}/api/customers/19991111-4325/credit-score

### Kontrollera Anna direkt i CreditScore Azure

GET https://creditscoreapielmstrom-amekd7ezcghaabe2.westus3-01.azurewebsites.net/api/customers/19900101-2010/credit-score